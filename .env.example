# Enable only once publication checks in README.md are complete.
SITE_PUBLIC_INDEXING=false
# Allowed values after VAT treatment and price presentation are confirmed: inclusive, exclusive, no-vat.
SITE_VAT_TREATMENT=
# Enable only after real inbound and outbound mailbox tests pass.
SITE_EMAIL_VERIFIED=false
# Optional Search Console HTML meta tag token for the public site.
GOOGLE_SITE_VERIFICATION=
# Enable each public profile only after confirming it belongs to Gavin.
SITE_INSTAGRAM_VERIFIED=false
SITE_YOUTUBE_VERIFIED=false
# Use a verified Calendly or Google Calendar appointment scheduling URL.
SITE_BOOKING_URL=
SITE_LINKEDIN_URL=
SITE_GOOGLE_BUSINESS_PROFILE_URL=
# Optional GA4 measurement ID. The tag loads only after visitor opt-in.
SITE_GA_MEASUREMENT_ID=

# Leave off until the storage, privacy and publication checks are approved.
SITE_ACQUISITION_ENABLED=false
SITE_ATTRIBUTION_ENABLED=false
# Use only business-owned infrastructure and separate non-production storage.
ACQUISITION_DATABASE_URL=
ACQUISITION_ADMIN_DATABASE_URL=
ACQUISITION_SECURITY_KEY=
SITE_ACQUISITION_ORIGIN=
# Only for self-hosting behind a proxy that overwrites this header.
SITE_TRUSTED_CLIENT_IP_HEADER=
CALENDLY_WEBHOOK_SECRET=

# Optional analytics and advertising tags. Use approved IDs from business-owned accounts.
SITE_GTM_ID=
SITE_META_PIXEL_ID=
META_GRAPH_VERSION=
META_CONVERSIONS_ACCESS_TOKEN=
SITE_GOOGLE_ADS_ID=
SITE_GOOGLE_ADS_LEAD_LABEL=

# Zoho email automation runs only on an authenticated scheduler POST.
SITE_ZOHO_AUTOMATION_ENABLED=false
SITE_ZOHO_TEMPLATES=
SITE_ZOHO_NURTURE_DELAY_DAYS=
SALES_JOB_SECRET=
ZOHO_REGION=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_FROM_EMAIL=
