# Enable only once publication checks in README.md are complete.
SITE_PUBLIC_INDEXING=false
# Allowed values after VAT treatment and price presentation are confirmed: inclusive, exclusive, no-vat.
SITE_VAT_TREATMENT=
# Enable only after real inbound and outbound mailbox tests pass.
SITE_EMAIL_VERIFIED=false
# Optional Search Console HTML meta tag token for the public site.
GOOGLE_SITE_VERIFICATION=
# Enable each public profile only after confirming it belongs to Gavin.
SITE_INSTAGRAM_VERIFIED=false
SITE_YOUTUBE_VERIFIED=false
# Use a verified Calendly or Google Calendar appointment scheduling URL.
SITE_BOOKING_URL=
SITE_LINKEDIN_URL=
SITE_GOOGLE_BUSINESS_PROFILE_URL=
# Optional GA4 measurement ID. The tag loads only after visitor opt-in.
SITE_GA_MEASUREMENT_ID=
